---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="#inicio" class:list={['brand', className]} aria-label="SAVE Hospital Veterinário — ir para o início">
  <img
    src="/media/logo-save.jpg"
    alt=""
    width="44"
    height="44"
    class="brand-logo"
    decoding="async"
  />
  <span class="brand-text">
    <span class="brand-name">SAVE</span>
    <span class="brand-sub">Hospital Veterinário</span>
  </span>
</a>
