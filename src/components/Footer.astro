---
import Brand from './Brand.astro';
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <Brand class="brand--footer" />
        <p>
          Hospital veterinário em Santa Quitéria, Curitiba. Cuidado especializado
          para o seu pet.
        </p>
        <div class="footer-social">
          <a href="https://www.instagram.com/savecentroveterinario" target="_blank" rel="noopener">
            Instagram
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
          </a>
          <a href="https://www.facebook.com/savecentroveterinario" target="_blank" rel="noopener">
            Facebook
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
          </a>
        </div>
      </div>

      <nav class="footer-col" aria-label="Navegação do rodapé">
        <p class="footer-title">Navegar</p>
        <div class="footer-links">
          <a href="#novo-hospital">O hospital</a>
          <a href="#estrutura">Estrutura</a>
          <a href="#servicos">Serviços</a>
          <a href="#historia">História</a>
          <a href="#contato">Contato</a>
        </div>
      </nav>

      <div class="footer-col">
        <p class="footer-title">Contato</p>
        <div class="footer-links">
          <a href="https://wa.me/5541996665808" target="_blank" rel="noopener">WhatsApp</a>
          <a href="tel:+554130455808">3045-5808</a>
          <a href="https://www.instagram.com/savecentroveterinario" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/savecentroveterinario" target="_blank" rel="noopener">Facebook</a>
        </div>
      </div>

      <div class="footer-col">
        <p class="footer-title">Endereço</p>
        <address>
          Rua Curupaitis, 1366<br />
          Santa Quitéria<br />
          Curitiba / PR<br />
          <a
            href="https://www.google.com/maps/search/?api=1&query=Rua+Curupaitis+1366+Curitiba+PR"
            target="_blank"
            rel="noopener"
          >
            Ver no mapa
          </a>
        </address>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2026 SAVE · Serviço de Atendimento Veterinário Especializado</p>
      <a href="https://facilia.ia.br" class="facilia-credit" target="_blank" rel="noopener" aria-label="Facilia, abre em nova aba">
        Site por
        <img src="/media/facilia-logo.webp" alt="Facilia" width="86" height="51" loading="lazy" />
      </a>
    </div>
  </div>
</footer>
